# ENVIRONMENT
# NODE_ENV = runtime mode (development | production | test). Set by your run/
# deploy command, NOT here: the dev script sets it locally; on a server set
# NODE_ENV=production. Both staging and prod run as NODE_ENV=production.
#
# APP_ENV = deployment identity (development | staging | production | test).
# Decides which database this deployment is allowed to talk to. MUST be set
# explicitly on staging and prod; leave unset locally (defaults to development).
#   staging box  -> APP_ENV=staging     (NODE_ENV=production)
#   prod box     -> APP_ENV=production  (NODE_ENV=production)
# SECURITY: on servers set APP_ENV in the systemd unit / deploy target, NOT in a
# portable .env that could be copied between boxes (that's the one cross-env
# mistake the DB identity guard cannot catch on its own).
APP_ENV=

# DATABASE
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TEST_DATABASE_URL=

# REDIS
REDIS_URL=

# COOKIE
COOKIE_DOMAIN=

#RESEND
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Routing this address in Cloudflare Email Routing so users reply land here
EMAIL_REPLY_TO=

#BETTER-AUTH
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# SERVER
PORT=

# CRON JOB CONFIGURATION
CRON_ENABLED=
CRON_FOOD_STATUS_TIME=
CRON_MANUAL_TRIGGER_ENABLED=
CRON_LOG_LEVEL=

# PINO LOGGING
LOG_LEVEL=